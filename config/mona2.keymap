#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <mouse-gesture.dtsi>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

// ① タブ操作ジェスチャー（; 長押し中）
&zip_mouse_gesture {
    stroke-size = <200>;
    enable-eager-mode;
    always-active;
    suppress-movement;

    tab_previous {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LC(LS(TAB))>;
    };

    tab_next {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LC(TAB)>;
    };

    new_tab {
        pattern = <GESTURE_UP>;
        bindings = <&kp LC(T)>;
    };

    close_tab {
        pattern = <GESTURE_DOWN>;
        bindings = <&kp LC(W)>;
    };
};

/ {
    // ② デスクトップ操作ジェスチャー（O+P 長押し中）
    zip_mouse_gesture_desktop: zip_mouse_gesture_desktop {
        compatible = "zmk,input-processor-mouse-gesture";
        #input-processor-cells = <0>;
        stroke-size = <200>;
        enable-eager-mode;
        always-active;
        suppress-movement;

        desktop_previous {
            pattern = <GESTURE_LEFT>;
            bindings = <&kp LG(LC(LEFT_ARROW))>;
        };

        desktop_next {
            pattern = <GESTURE_RIGHT>;
            bindings = <&kp LG(LC(RIGHT_ARROW))>;
        };

        task_view {
            pattern = <GESTURE_UP>;
            bindings = <&kp LG(TAB)>;
        };

        move_window_to_next_desktop {
            pattern = <GESTURE_DOWN>;
            bindings = <&kp LG(LC(LS(RIGHT_ARROW)))>;
        };
    };
    combos {
        compatible = "zmk,combos";

        layer4_ESC {
            bindings = <&lt 4 ESC>;
            key-positions = <39 38>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
        };

        // O+P：タップで Alt+Tab、長押しでデスクトップ操作ジェスチャー
        alt_tab_gesture {
            bindings = <&lt 7 LA(TAB)>;
            key-positions = <8 9>;
            layers = <0>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
        };
    };

    behaviors {
        // O: タップでO、長押しでレイヤー3（トラックボールでスクロール）
        lt_o: lt_o {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <300>;
            // 直前のキーから150ms以内に押したOは必ずOとして扱う（タイピング中の誤作動防止）
            require-prior-idle-ms = <150>;
            // Oを押したまま左手のキーを押した場合だけ長押し（レイヤー3）と判定する
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 21 22 23 24 25 26 33 34 35 36 37 38>;
        };

        // ;：タップで ;、長押しでタブ操作ジェスチャー
        lt_semi: lt_semi {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 21 22 23 24 25 26 33 34 35 36 37 38>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R             &kp T                                               &kp Y        &kp U  &kp I      &lt_o 3 O  &kp P
&kp A             &kp S         &kp D         &kp F             &kp G                            &kp MINUS          &kp H        &kp J  &kp K      &kp L    &lt_semi 6 SEMICOLON
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V             &kp B        &kp DELETE          &kp DOUBLE_QUOTES  &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt 4 LANGUAGE_2  &lt 2 SPACE  &lt 3 LANGUAGE_1    &kp BACKSPACE      &lt 1 ENTER                             &kp LEFT_ALT
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_1 {
            bindings = <
&trans                   &kp AMPERSAND    &kp ASTERISK  &kp LPAR   &kp RPAR                                &trans  &kp LBKT  &kp RBKT  &trans     &trans
&kp GRAVE                &kp DOLLAR       &kp PERCENT   &kp CARET  &trans                  &trans          &trans  &kp LPAR  &kp RPAR  &kp BSLH   &trans
&mt LEFT_SHIFT MINUS     &kp EXCLAMATION  &kp AT_SIGN   &kp HASH   &trans     &trans       &trans          &trans  &kp LBRC  &kp RBRC  &kp PIPE   &trans
&trans                   &trans           &trans        &trans     &trans     &trans       &trans          &trans                                &trans
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        layer_2 {
            bindings = <
&trans  &kp N7  &kp N8  &kp N9  &kp PLUS                     &trans  &kp F7  &kp F8  &kp F9  &kp F12
&trans  &kp N4  &kp N5  &kp N6  &kp MINUS            &trans  &trans  &kp F4  &kp F5  &kp F6  &kp F11
&kp N0  &kp N1  &kp N2  &kp N3  &kp EQUAL  &trans    &trans  &trans  &kp F1  &kp F2  &kp F3  &kp F10
&trans  &trans  &trans  &trans  &trans     &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_3 {
            bindings = <
&kp PG_UP  &trans          &kp UP_ARROW    &trans           &kp PG_DN                                  &trans  &trans            &kp LG(UP_ARROW)    &trans             &trans
&kp HOME   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END                &kp LC(LG(PSCRN))   &trans  &kp LG(LEFT_ARROW)  &kp LG(DOWN_ARROW)  &kp LG(RIGHT_ARROW)  &trans
&trans     &trans          &trans          &trans           &trans     &trans      &kp LS(PSCRN)       &trans  &trans            &trans              &trans             &trans
&trans     &trans          &trans          &trans           &trans     &trans      &kp DELETE          &trans                                                         &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(TAB) LC(LS(TAB))>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans            &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans                                                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        mouse_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                                &trans
            >;
        };

        gesture_tabs {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;
        };

        gesture_desktop {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;
        };
    };
};
